<?xml version="1.0" encoding="utf-8"?>
<!--
  RavenWatch icon — night-vision radar scope.
  Viewport 108×108, center 54,54, radius 47.

  Sweep wedge: 120° (1/3 of circle), four 30° filled slices fading dim→bright.
  Angles measured clockwise from North (12-o'clock):
    Trail end  285° → point (9, 42)
               315° → point (21, 21)
               345° → point (42, 9)
    Near lead   15° → point (66, 9)
    Lead edge   45° → point (87, 21)   [NE, upper-right]
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background -->
    <path
        android:fillColor="#030D03"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"/>

    <!-- Scope face -->
    <path
        android:fillColor="#050F05"
        android:pathData="M4,54 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0"/>

    <!-- Range ring r=15 -->
    <path
        android:strokeColor="#0F2E0F"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:pathData="M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>

    <!-- Range ring r=28 -->
    <path
        android:strokeColor="#0F2E0F"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"/>

    <!-- Range ring r=41 -->
    <path
        android:strokeColor="#0F2E0F"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:pathData="M13,54 a41,41 0 1,0 82,0 a41,41 0 1,0 -82,0"/>

    <!-- Outer border ring -->
    <path
        android:strokeColor="#1A5C1A"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:pathData="M4,54 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0"/>

    <!-- ── Sweep wedge: four 30° slices, 285°→45° CW from North ── -->

    <!-- Slice 1: 285°→315° — dimmest (trail) -->
    <path
        android:fillColor="#183C18"
        android:pathData="M54,54 L9,42 A47,47 0 0,1 21,21 Z"/>

    <!-- Slice 2: 315°→345° -->
    <path
        android:fillColor="#2E7A2E"
        android:pathData="M54,54 L21,21 A47,47 0 0,1 42,9 Z"/>

    <!-- Slice 3: 345°→15° (crosses through top of circle) -->
    <path
        android:fillColor="#4AB84A"
        android:pathData="M54,54 L42,9 A47,47 0 0,1 66,9 Z"/>

    <!-- Slice 4: 15°→45° — brightest (near leading edge) -->
    <path
        android:fillColor="#82EE82"
        android:pathData="M54,54 L66,9 A47,47 0 0,1 87,21 Z"/>

    <!-- Center glow -->
    <path
        android:fillColor="#1D5C1D"
        android:pathData="M49,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"/>
    <path
        android:fillColor="#55EE55"
        android:pathData="M51.5,54 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"/>

    <!-- Contact blip at 45°, r=30: (75, 33) -->
    <path
        android:fillColor="#1A6630"
        android:pathData="M70,33 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"/>
    <path
        android:fillColor="#99FFBB"
        android:pathData="M72,33 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>

    <!-- ── Letter R — stroke-based, centered at (54,54), bold phosphor green ── -->
    <!-- R spans x:43–67, y:39–69. Path: stem up → top bar → bowl curve → crossbar → leg -->

    <!-- Dark halo gives contrast against the bright sweep -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#081808"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M43,69 L43,39 L56,39 C64,39 67,43 67,47 C67,51 64,55 56,55 L43,55 M56,55 L65,69"/>

    <!-- Bright R stroke -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#55EE55"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M43,69 L43,39 L56,39 C64,39 67,43 67,47 C67,51 64,55 56,55 L43,55 M56,55 L65,69"/>

</vector>
