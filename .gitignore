# ── AI coding assistant files ──────────────────────────────────────────────────
# Claude Code (Anthropic) — contains local permission grants and machine-specific
# paths; settings.local.json especially must never be committed.
.claude/
# Other AI tools — add as needed if you use them
.cursor/
.cursorignore
.cursorrules
.aider*
.continue/
.codeium/
.github/copilot-instructions.md

# ── Gradle build outputs ────────────────────────────────────────────────────────
.gradle/
build/
**/build/

# Local machine configuration — contains absolute SDK/NDK paths, never commit
local.properties

# Log files
*.log

# Android Studio generated files
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ / Android Studio IDE files
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Release signing keys — NEVER commit these
*.jks
*.keystore
keystore/
keystore.properties
sign_env.sh

# Google Services config (contains API keys)
google-services.json

# Android profiling snapshots
*.hprof

# Compiled class files
*.class

# OS-generated metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# CMake build artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Native build outputs (compiled .so files are generated by the build)
*.so.bak
